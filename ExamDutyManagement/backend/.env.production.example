# Production (Hostinger Business - Node.js web app + managed MySQL)
# Add these as Environment Variables in hPanel (do NOT commit real values).
NODE_ENV=production
# PORT is normally provided by Hostinger; uncomment only if needed
# PORT=5000

# From hPanel -> Databases -> Management (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_examduty
DB_USER=u123456789_examduty
DB_PASSWORD=your_database_password
DB_SSL=false

# false once tables exist (import mysql_schema.sql). true only for first-time auto-create.
DB_SYNCHRONIZE=false

# Your frontend URL(s), comma separated
CORS_ORIGINS=https://exam.yourdomain.com
