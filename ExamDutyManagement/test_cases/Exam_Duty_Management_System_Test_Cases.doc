<style>
  body {
    font-family: 'Calibri', 'Segoe UI', Arial, sans-serif;
    font-size: 11pt;
    line-height: 1.4;
    color: #1F2937;
    margin: 20mm 15mm 20mm 15mm;
  }
  h1 {
    font-size: 20pt;
    color: #1E3A8A;
    border-bottom: 2pt solid #1E3A8A;
    padding-bottom: 6px;
    margin-bottom: 12px;
  }
  h2 {
    font-size: 14pt;
    color: #1E40AF;
    margin-top: 20px;
    margin-bottom: 8px;
    border-bottom: 1pt solid #DBEAFE;
    padding-bottom: 4px;
  }
  .summary-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .summary-table td, .summary-table th {
    border: 1pt solid #94A3B8;
    padding: 6px 10px;
    font-size: 10pt;
  }
  .summary-table th {
    background-color: #F1F5F9;
    color: #0F172A;
    text-align: left;
    width: 25%;
  }
  .kpi-box-row {
    margin-bottom: 20px;
  }
  .kpi-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
  }
  .kpi-table td {
    border: 1.5pt solid #CBD5E1;
    padding: 10px;
    background-color: #F8FAFC;
  }
  .kpi-val {
    font-size: 16pt;
    font-weight: bold;
    color: #047857;
  }
  .kpi-lbl {
    font-size: 9pt;
    color: #475569;
    text-transform: uppercase;
    font-weight: bold;
  }
  .test-case-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 25px;
    font-size: 9.5pt;
  }
  .test-case-table th {
    background-color: #1E3A8A;
    color: #FFFFFF;
    border: 1pt solid #0F172A;
    padding: 7px 6px;
    text-align: left;
    font-weight: bold;
  }
  .test-case-table td {
    border: 1pt solid #94A3B8;
    padding: 6px 6px;
    vertical-align: top;
  }
  .test-case-table tr:nth-child(even) {
    background-color: #F8FAFC;
  }
  .badge-pass {
    background-color: #DCFCE7;
    color: #166534;
    font-weight: bold;
    padding: 3px 6px;
    border: 1pt solid #86EFAC;
    border-radius: 3px;
    display: inline-block;
    text-align: center;
  }
  .badge-p1 {
    color: #B91C1C;
    font-weight: bold;
  }
  .badge-p2 {
    color: #D97706;
    font-weight: bold;
  }
  .badge-p3 {
    color: #2563EB;
  }
  .col-id { width: 10%; font-weight: bold; }
  .col-title { width: 22%; }
  .col-steps { width: 26%; }
  .col-expected { width: 24%; }
  .col-status { width: 8%; text-align: center; }
  .col-prio { width: 10%; text-align: center; }
  .footer-note {
    font-size: 9pt;
    color: #64748B;
    margin-top: 30px;
    border-top: 1pt solid #CBD5E1;
    padding-top: 8px;
    text-align: right;
  }
</style>
</head>
<body>

<h1>EXAM DUTY MANAGEMENT SYSTEM - QA TEST EXECUTION REPORT</h1>

<table class="summary-table">
