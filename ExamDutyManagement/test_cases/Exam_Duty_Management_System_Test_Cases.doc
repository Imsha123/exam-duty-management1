  </tr>
  <tr>
    <th>Tested By:</th>
    <td>QA Automation & Validation Engineer</td>
    <th>Target Environment:</th>
    <td>Localhost (Backend: MSSQL & NestJS, Frontend: React)</td>
  </tr>
  <tr>
    <th>Admin Test Account:</th>
    <td>devsupport (dev@support123) / Mohan (Mohan@123)</td>
    <th>Admin Resource ID:</th>
    <td>5914 (Dummy ID: Mohan, Email: mohan@gmail.com)</td>
  </tr>
  <tr>
    <th>Overall Result:</th>
    <td style="color: #166534; font-weight: bold; font-size: 11pt;">ALL TEST CASES PASSED (100% SUCCESS)</td>
    <th>Execution Tool:</th>
    <td>Automated Regression Engine & Browser Verifier</td>
  </tr>
</table>

